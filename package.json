{
  "name": "useful-copy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "deploy": "bun run build && bun --bun wrangler deploy",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun oxlint --deny-warnings .",
    "format": "bun --bun oxfmt .",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bun --bun wrangler d1 migrations apply DB --remote",
    "cf:typegen": "bun --bun wrangler types cloudflare-env.d.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-solid": "1.47.0",
    "solid-js": "1.9.15",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vite-plugin-solid": "2.11.14",
    "wrangler": "4.136.3"
  },
  "packageManager": "bun@1.4.2"
}
